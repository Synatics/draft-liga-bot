# Alle drei Pflichtwerte vor dem Start ersetzen; Discord-IDs als Ziffernfolge eintragen.
DISCORD_TOKEN=dein-bot-token
CLIENT_ID=deine-application-id
# Einmalig die bestehende Liga-Teilnehmerrolle konfigurieren und jede Season weiterverwenden.
PARTICIPANT_ROLE_ID=deine-teilnehmerrollen-id
# Bestehende Rolle für Ligaverwaltung. Ohne Wert sind Verwaltungsaktionen im Bot gesperrt.
# Die Rolle benötigt keine Administrator-, Serververwaltungs- oder Nachrichtenverwaltungsrechte.
# LEAGUE_MANAGER_ROLE_ID=deine-ligaverwaltungsrollen-id
# Datenordner für Liga-Einstellungen und Replay-Archiv. Lokal standardmäßig ./data.
# Railway: Volume mit Mount Path /data hinzufügen; der Bot erkennt es automatisch.
# DATA_DIR ist optional und muss auf Railway innerhalb des Volumes liegen.
# DATA_DIR=./data
